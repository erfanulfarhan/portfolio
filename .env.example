# Server-side keys for the two functions in api/. Copy to .env for `npm run dev`;
# in production they are Vercel environment variables.

# api/chat.js, the "ask about my work" assistant. https://console.groq.com/keys
GROQ_API_KEY=

# api/contact.js, which emails contact form messages through Brevo.
BREVO_API_KEY=
