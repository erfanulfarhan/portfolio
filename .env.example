# Server-side keys for the functions in api/. Copy to .env for `npm run dev`;
# in production they are Vercel environment variables.

# api/chat.js, the "ask about my work" assistant. https://console.groq.com/keys
# A key derived from it also signs the assistant's answers for api/transcript.js.
GROQ_API_KEY=

# api/contact.js and api/transcript.js, which email contact form messages,
# messages the assistant passes on, and chat transcripts through Brevo.
BREVO_API_KEY=
