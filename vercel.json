{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "dest": "/public/index.html" },
    { "src": "/app.js", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "dest": "/public/app.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
